{
  "name": "pronotes",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ProNotes: iPad-first offline Bangla legal drafting PWA",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
